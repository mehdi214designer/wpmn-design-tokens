{
  "id": "product-showcase",
  "name": "Showcase 6",
  "type": "html",
  "status": "stable",
  "description": "E-commerce best picks grid: large featured product card spanning two rows + 2x2 grid of smaller cards. Soft grey card fills, image zoom + lift on hover, staggered fade-up reveal on scroll, View All pill.",
  "files": {
    "html": "sections/product-showcase/section.html"
  },
  "prompt": "sections/product-showcase/prompt.md",
  "dependsOn": [
    "index.css"
  ],
  "baseClass": "wpmn-sec-product-showcase",
  "slots": [
    "heading",
    "view-all-pill",
    "featured-card",
    "product-grid-2x2"
  ],
  "interactions": [
    "staggered reveal: cards fade-up (16px, 500ms ease, 80ms stagger) via IntersectionObserver",
    "card hover: lift -2px + --shadow-soft-300, image scale 1.04 (300ms ease)",
    "View All pill hover: fills --btn-bg-enable with invert text",
    "prefers-reduced-motion: all transforms disabled"
  ],
  "tokensUsed": [
    "--color-surface-primary",
    "--color-text-*",
    "--btn-bg-enable",
    "--color-border-primary",
    "--radius-md",
    "--radius-xsm",
    "--radius-lg",
    "--font-*",
    "--shadow-soft-300"
  ],
  "layout": {
    "container": "1200px centered",
    "sectionPadding": "96px desktop / 64px mobile",
    "grid": "2fr 1fr 1fr, featured spans 2 rows, 24px gap"
  },
  "brands": "all",
  "themes": [
    "light",
    "dark"
  ],
  "category": "Sections",
  "subcategory": "Grids",
  "role": "Showcase",
  "tags": [
    "product showcase",
    "ecommerce",
    "products",
    "best picks",
    "featured",
