{
  "id": "navbar",
  "name": "NavBar",
  "type": "react",
  "status": "stable",
  "figmaNode": "341:657",
  "description": "Responsive site header. Desktop: logo + nav links + primary CTA. Mobile: logo + secondary CTA + hamburger with slide-down drawer.",
  "files": {
    "jsx": "components/NavBar/NavBar.jsx",
    "css": "components/NavBar/NavBar.css"
  },
  "prompt": "components/NavBar/prompt.md",
  "dependsOn": ["index.css"],
  "baseClass": "wpmn-navbar",
  "props": {
    "logo": { "type": "ReactNode" },
    "links": { "type": "Array<{label, href, active?}>" },
    "ctaLabel": { "type": "string", "default": "Sign Up" },
    "ctaHref": { "type": "string", "default": "#" },
    "onCtaClick": { "type": "function" }
  },
  "states": ["desktop", "mobile-closed", "mobile-open", "link-hover", "link-active"],
  "interactions": [
    "link hover: color shift + light bg, 120ms ease",
    "CTA hover/active/focus follow button primary states",
    "hamburger toggles drawer, icon swaps hamburger/close",
    "drawer link click closes drawer",
    "a11y: aria-expanded, aria-controls, aria-current on active link"
  ],
  "tokensUsed": [
    "--color-surface-primary", "--color-text-primary", "--color-text-secondary", "--color-text-primary-invert",
    "--btn-bg-enable", "--btn-bg-hovered", "--btn-bg-pressed", "--btn-bg-focused",
    "--color-border-primary", "--primitive-radius-xs", "--primitive-light-25", "--primitive-primary-50",
    "--font-family-base", "--font-weight-regular", "--font-weight-medium"
  ],
  "breakpoint": "768px",
  "brands": "all",
  "themes": ["light", "dark"]
}
